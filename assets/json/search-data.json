{{/* FlexSearch Index Data */}}
{{- $indexType := site.Params.search.flexsearch.index | default "content" -}}

{{- if not (in (slice "content" "summary" "heading" "title" ) $indexType) -}}
  {{- errorf "unknown flexsearch index type: %s" $indexType -}}
{{- end -}}

{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.excludeSearch" "!=" true -}}
{{- $pages = where $pages "Content" "!=" "" -}}

{{- $output := dict -}}

{{- range $index, $page := $pages -}}
  {{- $pageTitle := $page.LinkTitle | default $page.File.BaseFileName -}}
  {{- $pageLink := $page.RelPermalink -}}
  {{- $data := partial "utils/fragments" (dict "context" $page "type" $indexType) -}}
  {{- $entry := dict "title" $pageTitle "data" $data -}}
  {{- /* kuberik (R13-IA-4): `keywords:` front matter, extra search terms for the page's own entry. */ -}}
  {{- with $page.Params.keywords }}{{ $entry = merge $entry (dict "keywords" (cond (reflect.IsSlice .) . (slice .))) }}{{ end -}}
  {{- /* kuberik (R6-IA-3): API-reference field rows (<tr id="rolloutspec-baketime">) so a field-name query links to its row. */ -}}
  {{- $fields := slice -}}
  {{- range findRESubmatch `(?s)<tr id="([^"]+)"><td><code>([^<]+)</code>(.*?)</tr>` $page.Content -}}
    {{- $id := index . 1 -}}
    {{- $desc := index . 3 | replaceRE `(?s)^.*?</td>\s*<td>` "" | replaceRE `&lt;` "⟦" | replaceRE `&gt;` "⟧" | plainify | htmlUnescape | replaceRE `⟦` "<" | replaceRE `⟧` ">" | strings.TrimSpace -}}
    {{- $desc = index (split $desc "\n") 0 | strings.TrimSpace -}}
    {{- $type := index (split $id "-") 0 -}}
    {{- $fields = $fields | append (dict "id" $id "name" (index . 2) "type" (index (findRE `[^-]+` $id 1) 0) "desc" (cond (gt (len $desc) 220) (printf "%s…" (substr $desc 0 220)) $desc)) -}}
  {{- end -}}
  {{- if $fields }}{{ $entry = merge $entry (dict "fields" $fields) }}{{ end -}}
  {{- $output = $output | merge (dict $pageLink $entry) -}}
{{- end -}}

{{- $output | jsonify -}}
